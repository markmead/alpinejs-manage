{
  "name": "alpinejs-manage",
  "version": "2.0.0",
  "description": "Manage another Alpine JS elements `x-data` values 👩‍✈️",
  "keywords": [
    "alpine",
    "alpinejs",
    "alpinejs-plugin",
    "manage",
    "x-data"
  ],
  "license": "MIT",
  "author": "Mark Mead",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmead/alpinejs-manage.git"
  },
  "homepage": "https://github.com/markmead/alpinejs-manage#readme",
  "bugs": "https://github.com/markmead/alpinejs-manage/issues",
  "main": "dist/manage.cjs",
  "module": "dist/manage.mjs",
  "unpkg": "dist/manage.min.js",
  "exports": {
    ".": {
      "import": "./dist/manage.mjs",
      "require": "./dist/manage.cjs",
      "default": "./dist/manage.mjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "packageManager": "pnpm@11.1.3"
}
